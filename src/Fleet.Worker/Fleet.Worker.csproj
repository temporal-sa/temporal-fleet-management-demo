<Project Sdk="Microsoft.NET.Sdk">
  <!-- Worker host. Run all task queues in one process, or one queue per process (to demo killing a worker). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Brings in generic hosting, configuration and logging from the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fleet.Workflows\Fleet.Workflows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
